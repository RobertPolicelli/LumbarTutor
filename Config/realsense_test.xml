<PlusConfiguration version="2.3">

  <DataCollection StartupDelaySec="1.0">

    <DeviceSet
      Name="PlusServer: Intel RealSense two-camera minimal test"
      Description="Minimal RGB and depth streaming test for two Intel RealSense D415 cameras. No serial device, no virtual capture, no colorizer, no depth alignment."/>

    <Device Id="VideoDevice" Type="IntelRealSense">

      <DataSources>

        <!-- Camera 0: Intel RealSense D415, SN 025522060972 -->
        <DataSource
          Type="Video"
          Id="VideoRGB"
          DeviceSerialNumber="025522060972"
          FrameType="RGB"
          FrameSize="640 480"
          FrameRate="15"
          PortUsImageOrientation="UN"/>

        <DataSource
          Type="Video"
          Id="VideoDEPTH"
          DeviceSerialNumber="025522060972"
          FrameType="DEPTH"
          FrameSize="640 480"
          FrameRate="15"
          AlignDepthStream="FALSE"
          UseRealSenseColorizer="FALSE"
          PortUsImageOrientation="UN"/>


        <!-- Camera 1: Intel RealSense D415, SN 141722064250 -->
        <DataSource
          Type="Video"
          Id="Video1RGB"
          DeviceSerialNumber="141722064250"
          FrameType="RGB"
          FrameSize="640 480"
          FrameRate="15"
          PortUsImageOrientation="UN"/>

        <DataSource
          Type="Video"
          Id="Video1DEPTH"
          DeviceSerialNumber="141722064250"
          FrameType="DEPTH"
          FrameSize="640 480"
          FrameRate="15"
          AlignDepthStream="FALSE"
          UseRealSenseColorizer="FALSE"
          PortUsImageOrientation="UN"/>

      </DataSources>

      <OutputChannels>
        <OutputChannel Id="VideoStreamRGB" VideoDataSourceId="VideoRGB"/>
        <OutputChannel Id="VideoStreamDEPTH" VideoDataSourceId="VideoDEPTH"/>
        <OutputChannel Id="VideoStream1RGB" VideoDataSourceId="Video1RGB"/>
        <OutputChannel Id="VideoStream1DEPTH" VideoDataSourceId="Video1DEPTH"/>
      </OutputChannels>

    </Device>

  </DataCollection>


  <!-- Camera 0 RGB server -->
  <PlusOpenIGTLinkServer
    MaxNumberOfIgtlMessagesToSend="1"
    MaxTimeSpentWithProcessingMs="50"
    ListeningPort="18945"
    SendValidTransformsOnly="true"
    OutputChannelId="VideoStreamRGB">

    <DefaultClientInfo>
      <MessageTypes>
        <Message Type="VIDEO"/>
      </MessageTypes>
      <VideoNames>
        <Video Name="ImageRGB" EmbeddedTransformToFrame="ImageRGB" EncodingLossless="False">
          <Encoding FourCC="VP90" Lossless="False" Speed="8" DeadlineMode="realtime" RateControl="CQ"/>
        </Video>
      </VideoNames>
    </DefaultClientInfo>

  </PlusOpenIGTLinkServer>


  <!-- Camera 0 DEPTH server -->
  <PlusOpenIGTLinkServer
    MaxNumberOfIgtlMessagesToSend="1"
    MaxTimeSpentWithProcessingMs="50"
    ListeningPort="18950"
    SendValidTransformsOnly="true"
    OutputChannelId="VideoStreamDEPTH">

    <DefaultClientInfo>
      <MessageTypes>
        <Message Type="VIDEO"/>
      </MessageTypes>
      <VideoNames>
        <Video Name="ImageDEPTH" EmbeddedTransformToFrame="ImageDEPTH" EncodingLossless="False">
          <Encoding FourCC="VP90" Lossless="False" Speed="8" DeadlineMode="realtime" RateControl="CQ"/>
        </Video>
      </VideoNames>
    </DefaultClientInfo>

  </PlusOpenIGTLinkServer>


  <!-- Camera 1 RGB server -->
  <PlusOpenIGTLinkServer
    MaxNumberOfIgtlMessagesToSend="1"
    MaxTimeSpentWithProcessingMs="50"
    ListeningPort="18949"
    SendValidTransformsOnly="true"
    OutputChannelId="VideoStream1RGB">

    <DefaultClientInfo>
      <MessageTypes>
        <Message Type="VIDEO"/>
      </MessageTypes>
      <VideoNames>
        <Video Name="Image1RGB" EmbeddedTransformToFrame="Image1RGB" EncodingLossless="False">
          <Encoding FourCC="VP90" Lossless="False" Speed="8" DeadlineMode="realtime" RateControl="CQ"/>
        </Video>
      </VideoNames>
    </DefaultClientInfo>

  </PlusOpenIGTLinkServer>


  <!-- Camera 1 DEPTH server -->
  <PlusOpenIGTLinkServer
    MaxNumberOfIgtlMessagesToSend="1"
    MaxTimeSpentWithProcessingMs="50"
    ListeningPort="18948"
    SendValidTransformsOnly="true"
    OutputChannelId="VideoStream1DEPTH">

    <DefaultClientInfo>
      <MessageTypes>
        <Message Type="VIDEO"/>
      </MessageTypes>
      <VideoNames>
        <Video Name="Image1DEPTH" EmbeddedTransformToFrame="Image1DEPTH" EncodingLossless="False">
          <Encoding FourCC="VP90" Lossless="False" Speed="8" DeadlineMode="realtime" RateControl="CQ"/>
        </Video>
      </VideoNames>
    </DefaultClientInfo>

  </PlusOpenIGTLinkServer>

</PlusConfiguration>